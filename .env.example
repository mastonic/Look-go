# OpenAI
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Current beta video provider. Keep configurable because video APIs can evolve.
OPENAI_VIDEO_MODEL=sora-2

# Google image generation
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# Optional curated/current fashion context injected into Try-On prompts.
# Do not put customer data here.
LOOKGO_FASHION_TREND_CONTEXT=

# AI unit-cost estimates used only for internal telemetry.
# Set these from the current provider invoices/pricing instead of hard-coding prices in the app.
AI_COST_OPENAI_IMAGE_USD=
AI_COST_GOOGLE_IMAGE_USD=
AI_COST_OPENAI_VIDEO_USD=
AI_COST_GOOGLE_VIDEO_USD=

# Live web search for direct merchant clothing links (P1 shopping under looks + shopping page)
BRAVE_SEARCH_API_KEY=

# Auth.js legacy/server routes
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console must have Anonymous + Email/Password enabled and the production/preview domains authorized.

# Optional local SQLite overrides
# LOOKGO_DATA_DIR=./data
# LOOKGO_SQLITE_PATH=./data/lookgo.db

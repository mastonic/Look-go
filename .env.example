# OpenAI
OPENAI_API_KEY=
# Vision model used to classify wardrobe photos into structured clothing items.
OPENAI_WARDROBE_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium
# Current beta video provider. Keep configurable because the current Sora video API is deprecated.
OPENAI_VIDEO_MODEL=sora-2

# Google image generation
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image

# AI unit-cost estimates used only for internal telemetry.
# Set these from the current provider invoices/pricing instead of hard-coding prices in the app.
AI_COST_OPENAI_IMAGE_USD=
AI_COST_GOOGLE_IMAGE_USD=
AI_COST_OPENAI_VIDEO_USD=
AI_COST_GOOGLE_VIDEO_USD=

# Shopping web search.
# Miyami/SearXNG is the primary provider. The public endpoint below works without an API key.
# For production reliability, point this variable to a self-hosted instance of
# https://github.com/ankushthakur2007/miyami_websearch_tool when available.
MIYAMI_SEARCH_API_URL=https://websearch.miyami.tech
MIYAMI_SEARCH_TIMEOUT_MS=9000
# Optional secondary provider. If empty, Look&Go falls back directly to its merchant directory.
BRAVE_SEARCH_API_KEY=

# Auth.js legacy/server routes
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Firebase Web
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase Console must have Anonymous + Email/Password enabled for the 6-digit beta access-code flow.
# Email link can remain enabled as an optional recovery path. Authorize the production domain as well.

# Firebase Admin (server-side, used by auth.ts and app/api/profile/* to store accounts/profiles in Firestore)
# Generate a service account key from Firebase Console -> Project settings -> Service accounts.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
